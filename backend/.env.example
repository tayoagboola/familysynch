# FastAPI JWT
SECRET_KEY=your-256-bit-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
CRON_SECRET=separate-secret-for-pg-cron

# Supabase — service role only — NEVER sent to Flutter
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Firebase (full service account JSON as a single-line string)
FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# App
APP_ENV=production
ALLOWED_ORIGINS=https://familysync.app
HEROKU_APP_URL=https://familysync-api.herokuapp.com
